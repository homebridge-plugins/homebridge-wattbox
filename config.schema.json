{
  "pluginAlias": "WattBox",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "WattBox",
        "minLength": 1,
        "required": true
      },
      "address": {
        "title": "WattBox Address",
        "description": "Hostname or IP of the WattBox. For the Integration Protocol use a bare host or host:port (e.g. 192.168.1.100 or 192.168.1.100:23). For the legacy HTTP API use a URL (e.g. http://192.168.1.100).",
        "type": "string",
        "default": "192.168.1.100",
        "minLength": 7,
        "required": true
      },
      "transport": {
        "title": "Transport",
        "description": "How to talk to the WattBox. 'auto' probes the Integration Protocol and falls back to the legacy HTTP/XML API. 'integration' forces the Integration Protocol (current OvrC firmware). 'http' forces the legacy HTTP/XML API (older firmware).",
        "type": "string",
        "default": "auto",
        "oneOf": [
          { "title": "Auto-detect", "enum": ["auto"] },
          { "title": "Integration Protocol (TCP)", "enum": ["integration"] },
          { "title": "Legacy HTTP/XML API", "enum": ["http"] }
        ],
        "required": false
      },
      "port": {
        "title": "Integration Protocol Port",
        "description": "TCP port for the Integration Protocol. Defaults to 23. Ignored by the HTTP transport.",
        "type": "integer",
        "default": 23,
        "minimum": 1,
        "maximum": 65535,
        "required": false
      },
      "username": {
        "title": "User Name",
        "type": "string",
        "default": "wattbox",
        "required": true
      },
      "password": {
        "title": "Password",
        "type": "string",
        "default": "wattbox",
        "required": true,
        "options": {
          "hidden": true
        }
      },
      "includeOutlets": {
        "title": "Include Outlets",
        "type": "array",
        "default": [],
        "required": false,
        "items": {
          "title": "Outlet Name",
          "type": "string"
        }
      },
      "excludeOutlets": {
        "title": "Exclude Outlets",
        "type": "array",
        "default": [],
        "required": false,
        "items": {
          "title": "Outlet Name",
          "type": "string"
        }
      },
      "outletStatusCacheTtl": {
        "title": "Outlet Status Cache TTL (in seconds)",
        "type": "integer",
        "default": 15,
        "minimum": 5,
        "maximum": 60,
        "required": true
      },
      "outletStatusPollInterval": {
        "title": "Outlet Status Poll Interval (in milliseconds)",
        "type": "integer",
        "default": 15000,
        "minimum": 5000,
        "maximum": 60000,
        "required": true
      }
    }
  },
  "layout": [
    "name",
    "address",
    "username",
    "password",
    {
      "type": "section",
      "title": "Connection",
      "expandable": true,
      "expanded": false,
      "items": ["transport", "port"]
    },
    {
      "type": "section",
      "title": "Advanced Settings",
      "expandable": true,
      "expanded": false,
      "items": [
        {
          "key": "includeOutlets",
          "type": "array",
          "name": "Included Outlets",
          "orderable": false,
          "items": ["includeOutlets[]"]
        },
        {
          "key": "excludeOutlets",
          "type": "array",
          "name": "Excluded Outlets",
          "orderable": false,
          "items": ["excludeOutlets[]"]
        },
        "outletStatusCacheTtl",
        "outletStatusPollInterval"
      ]
    }
  ]
}
